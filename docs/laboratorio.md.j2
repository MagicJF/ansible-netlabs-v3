| Tránsito router ↔ su firewall ({{ corto[s.id] }}) | `{{ s.transito.red }}` | router `{{ s.transito.rt }}` ↔ firewall `{{ s.transito.fw }}` |
{% endfor %}
{% for s in sedes if s.id != hub %}
| Enlace WAN {{ corto[hub] }} ↔ {{ corto[s.id] }} | `{{ s.wan.red }}` | `{{ equipo(hub, 'firewall') }}` `{{ s.wan.hub }}` ↔ `{{ equipo(s.id, 'firewall') }}` `{{ s.wan.spoke }}` |

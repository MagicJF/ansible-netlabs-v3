#!/bin/sh
# Pre-commit: dos recordatorios, ninguno bloquea (siempre exit 0).
#
#  1. caducidad — si commiteas algo (código o un documento), avisa de los documentos que
#     citan un fichero que cambió desde su última revisión. Es la respuesta automática a
#     «¿a qué documento afecta lo que he tocado?».
#  2. refs — si lo que commiteas toca `configure/` o `playbooks/`, imprime qué documentos
#     citan cada fichero. El puntero va del doc al código; el cambio va al revés.
#
# Para saltarlo: `git commit --no-verify`.
raiz=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$raiz" || exit 0

echo "=========================================================="
echo " caducidad — documentos que citan código que has movido"
echo "=========================================================="
python3 playbooks/tools/framework_check.py caducidad 2>/dev/null
echo "=========================================================="

citados=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
  | grep -E '^(configure/|playbooks/)' | grep -v '^playbooks/tools/framework_check\.py$')
[ -z "$citados" ] && exit 0

echo " refs — documentos que citan lo que estás commiteando"
echo "=========================================================="
echo "$citados" | while read -r f; do
  [ -f "$f" ] || continue
  python3 playbooks/tools/framework_check.py refs "$f" 2>/dev/null
done
echo "=========================================================="
exit 0
